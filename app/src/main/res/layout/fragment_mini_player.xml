<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/miniPlayer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardBackgroundColor="@color/boton"
    app:cardCornerRadius="8dp"
    app:cardElevation="8dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp">

        <!-- SeekBar (barra de progreso) -->
        <SeekBar
            android:id="@+id/miniSeekBar"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_marginHorizontal="12dp"
            android:thumb="@null"
            android:progressDrawable="@drawable/seekbar_mini_progress"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Imagen álbum -->
        <ImageView
            android:id="@+id/ivMiniAlbumArt"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:scaleType="centerCrop"
            android:src="@drawable/diosa"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/miniSeekBar"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Info canción -->
        <LinearLayout
            android:id="@+id/llMiniSongInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:orientation="vertical"
            app:layout_constraintStart_toEndOf="@id/ivMiniAlbumArt"
            app:layout_constraintEnd_toStartOf="@id/btnMiniPrevious"
            app:layout_constraintTop_toTopOf="@id/ivMiniAlbumArt"
            app:layout_constraintBottom_toBottomOf="@id/ivMiniAlbumArt">

            <TextView
                android:id="@+id/tvMiniSongTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/diosa"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvMiniArtist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mareux"
                android:textColor="#888888"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Botón anterior -->
        <ImageButton
            android:id="@+id/btnMiniPrevious"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_skip_previous"
            app:tint="#FFFFFF"
            app:layout_constraintEnd_toStartOf="@id/btnMiniPlayPause"
            app:layout_constraintTop_toTopOf="@id/ivMiniAlbumArt"
            app:layout_constraintBottom_toBottomOf="@id/ivMiniAlbumArt" />

        <!-- Play / Pause -->
        <ImageButton
            android:id="@+id/btnMiniPlayPause"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_play_arrow"
            app:tint="#FFFFFF"
            app:layout_constraintEnd_toStartOf="@id/btnMiniNext"
            app:layout_constraintTop_toTopOf="@id/ivMiniAlbumArt"
            app:layout_constraintBottom_toBottomOf="@id/ivMiniAlbumArt" />

        <!-- Siguiente -->
        <ImageButton
            android:id="@+id/btnMiniNext"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_skip_next"
            app:tint="#FFFFFF"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/ivMiniAlbumArt"
            app:layout_constraintBottom_toBottomOf="@id/ivMiniAlbumArt" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
